+F beta_identity(vector<F> r1, vector<F> r2){
+    F eval = F(1);
+    for(int i = 0; i < r1.size(); i++){
+        eval *= ((F(1)-r1[i])*(F(1)-r2[i])  + r1[i]*r2[i]);
+    }
+    return eval;
