+void get_field_vector(vector<F> &h_f, vector<__hhash_digest> &h){
+    F pow1 = F(1);
+    F pow2 = F(1ULL<<32)*F(1ULL<<32);
+    F pow3 = pow2*pow2;
+    F pow4 = pow3*pow3;
+    vector<unsigned long long int> arr(4);
+    for(int i = 0; i < h_f.size(); i++){
+        get_int64(arr,h[i]);
+        h_f[i] = F(arr[0]) + pow2*arr[1] + pow3*arr[2]+pow4*arr[3];
+    }
+    
+}
