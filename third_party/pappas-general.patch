+#include "nand_input.hpp"
+#include "coPIOP.h"
+#include "utils.hpp"
+#include <mpi.h>
+#include <fstream>
+#include <array>
+#include <stdexcept>
+#include <cstring>
+extern std::vector<std::vector<std::pair<int,int>>> A,B,C;
+extern int logm,logn;
+extern void transpose_R1CS_matrixes();
+namespace {
+std::string directory;
+size_t raw_rows,raw_wires,padded;
+uint64_t read_u64(std::istream& f){unsigned char b[8];f.read((char*)b,8);if(!f)throw std::runtime_error("short NAND file");uint64_t x=0;for(int i=0;i<8;i++)x|=uint64_t(b[i])<<(8*i);return x;}
+void require(bool ok,const char*s){if(!ok)throw std::runtime_error(s);}
+void magic(std::istream&f,const char*s){char b[8];f.read(b,8);require(bool(f)&&!memcmp(b,s,8),"NAND file format");}
+size_t pow2(size_t n){size_t x=1;while(x<n)x*=2;return x;}
+}
+bool nand_active(){return !directory.empty();}
+size_t nand_size(){return padded;}
+void nand_load(const std::string& path){
+ directory=path;std::ifstream f(path+"/relation.bin",std::ios::binary);magic(f,"PNXOR001");
+ raw_rows=read_u64(f);raw_wires=read_u64(f);padded=read_u64(f);
+ require(raw_rows>0&&raw_wires>0&&padded==pow2(padded)&&padded>=raw_rows&&padded>=raw_wires&&padded<(1u<<29),"NAND dimensions");
+ logm=logn=0;for(size_t x=padded;x>1;x/=2){++logm;++logn;}
+}
+void nand_matrices(){
+ std::ifstream f(directory+"/relation.bin",std::ios::binary);magic(f,"PNXOR001");
+ require(read_u64(f)==raw_rows&&read_u64(f)==raw_wires&&read_u64(f)==padded,"NAND dimensions changed");
+ A.assign(raw_rows,{});B=A;C=A;std::array<decltype(A)*,3> matrices{&A,&B,&C};
+ for(size_t row=0;row<raw_rows;row++)for(auto*matrix:matrices){size_t count=read_u64(f);require(count<=3,"XOR fanin");for(size_t j=0;j<count;j++){size_t wire=read_u64(f);require(wire<raw_wires,"NAND wire index");(*matrix)[row].push_back({int(wire),int(row)});}}
+ require(f.peek()==EOF,"trailing NAND relation");transpose_R1CS_matrixes();
+}
+void nand_witness(std::vector<F>&w,std::vector<F>&l,std::vector<F>&r,std::vector<F>&o){
+ std::ifstream f(directory+"/witness.bin",std::ios::binary);magic(f,"PNXORW01");require(read_u64(f)==raw_wires,"NAND witness dimension");
+ w.assign(padded,F(0));l.assign(padded,F(0));r=l;o=l;
