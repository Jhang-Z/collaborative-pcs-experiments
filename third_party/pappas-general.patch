+F get_offset_product(int size,int pos,vector<F> r){
+    vector<F> bits;
+    F prod = F(1);
+    for(int i = 0; i < r.size(); i++){
+        if(pos & 1){
+            bits.push_back(F(1));
+        }else{
+            bits.push_back(F(0));
+        }
+        pos = pos >> 1;
+    }
+    for(int i = 0; i < r.size()-(int)log2(size); i++){
+        prod *= (bits[r.size()-1-i]*r[r.size()-1-i]+ (F(1)-bits[r.size()-1-i])*(F(1) - r[r.size()-1-i]));
+    }
+    return prod;
+}
